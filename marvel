html,body{overflow-x:hidden}
header{background:none;border-bottom:0;padding:56px 20px 48px;margin-bottom:40px;isolation:isolate}
header:before{content:"";position:absolute;z-index:-1;top:0;bottom:0;left:50%;width:100vw;transform:translateX(-50%);background:radial-gradient(circle at calc(50% + min(470px,38vw)) 50%,transparent 0 44px,rgba(232,184,58,.16) 44px 49px,transparent 49px 74px,rgba(255,255,255,.06) 74px 79px,transparent 79px 104px,rgba(232,184,58,.10) 104px 109px,transparent 109px),linear-gradient(160deg,var(--hq-2),var(--hq))}
header:after{content:"";position:absolute;left:50%;width:100vw;transform:translateX(-50%);bottom:0;height:5px;background:linear-gradient(90deg,var(--crimson) 0 33.3%,var(--hq-gold) 33.3% 66.6%,var(--sky) 66.6%)}
.eyebrow{font-family:'Gothic A1',sans-serif;font-weight:600;font-size:15px;letter-spacing:.06em;text-transform:none;color:var(--hq-gold);margin-bottom:10px}
h1{font-family:'Gothic A1',sans-serif;font-weight:700;font-size:clamp(28px,4.6vw,44px);letter-spacing:-.01em;line-height:1.25;color:#f7f5ee;text-shadow:none;margin:0 0 14px}
.sub{color:#c5cde0;font-style:normal;font-size:16px;line-height:1.65;max-width:640px;text-wrap:balance}
.theme-toggle-btn{background:rgba(255,255,255,.08);border:1.5px solid rgba(232,184,58,.7);color:#fff}
.theme-toggle-btn:hover{background:rgba(255,255,255,.16)}

/* 검색/필터 */
.controls{gap:10px;margin-bottom:24px}
.controls input[type=text],.controls select,.advanced-row select,.shipping-control input{border:1.5px solid var(--rule);border-radius:8px;min-height:46px;font-size:16px;padding:10px 14px;background:var(--card);color:var(--parchment)}
.controls input[type=text]:focus,.controls select:focus,.advanced-row select:focus,.shipping-control input:focus{border-color:var(--sky);box-shadow:0 0 0 3px rgba(74,144,217,.22)}
.controls input[type=text]::placeholder{color:var(--sage-dim)}
.reset-filters-btn{border:1.5px solid var(--rule);border-radius:8px;min-height:46px;font-size:15px}
.wish-only-label{font-size:15px}
.advanced-options{border-radius:10px;border:1.5px solid var(--rule);background:var(--card)}
.advanced-options summary{font-size:15px;padding:13px 18px}
.shipping-control{background:var(--bg);border:1px solid var(--rule);border-radius:8px}
.tier-legend{font-size:14px;gap:18px;color:var(--sage)}
.dot{width:11px;height:11px}

/* 서브테마 제목: 작전 파일 탭 */
.theme-header{font-family:'Gothic A1',sans-serif;font-weight:700;font-size:19px;color:var(--parchment);text-align:left;background:var(--card);border:1px solid var(--rule);border-left:5px solid var(--hq-gold);border-radius:8px;padding:14px 18px;margin:12px 0 18px;letter-spacing:-.005em;word-break:keep-all;overflow-wrap:anywhere}
.theme-accordion{margin-bottom:10px}
.theme-accordion summary.theme-header{justify-content:flex-start;margin:0}
.theme-accordion summary.theme-header:hover{background:var(--card-hover)}
.theme-accordion summary.theme-header:after{margin-left:auto;color:var(--sage-dim);font-size:18px}
.theme-accordion[open] summary.theme-header{border-bottom-left-radius:0;border-bottom-right-radius:0;background:var(--card-hover)}
.theme-accordion-body{padding:22px 0 12px}
.theme-count{font-size:14px;color:var(--sage-dim);font-weight:500}
.theme-toggle-all button{border:1.5px solid var(--rule);color:var(--gold);font-size:14px;border-radius:8px;min-height:40px}

/* 세트 */
.set-block{margin-bottom:44px;padding-left:18px}
.set-head{padding-bottom:12px}
.set-boxart{background:#fff;border-radius:8px;width:68px;height:68px}
.set-name{font-weight:600;font-size:18px;color:var(--parchment)}
.set-code{font-size:13.5px;border-radius:6px;padding:2px 9px}
.set-year{font-size:14px;color:var(--sage-dim)}
:root[data-theme="dark"] .set-code{background:transparent!important;color:var(--sage)!important}

/* 카드 */
.card{border-radius:10px;border:1px solid var(--rule)}
.card:before{width:4px}
.card:hover{background:var(--card);transform:translateY(-3px);box-shadow:0 10px 24px rgba(15,26,51,.14);border-color:var(--gold-dim)}
.card-img{background:#fff;height:170px}
.card-img img{filter:none}
.card-body{padding:12px 14px 12px}
.card-name{font-size:15.5px;font-weight:500;line-height:1.45;min-height:45px;margin-bottom:8px;color:var(--parchment);word-break:keep-all}
.tier-tag{font-family:'Noto Sans KR',sans-serif;font-size:12.5px;font-weight:600;letter-spacing:0;text-transform:none;border-radius:999px;padding:2px 10px;margin-bottom:4px}
.wish-btn{background:rgba(15,26,51,.72)}

/* 통계/순위 */
.stats{border-radius:10px;overflow:hidden}
.stat .num{font-size:24px;color:var(--gold)}
.stat .lbl{font-size:14px}
.top10-section{background:var(--card);border:1px solid var(--rule);border-top:4px solid var(--hq-gold);border-radius:10px;padding:20px 22px}
.top10-title{font-family:'Gothic A1',sans-serif;font-weight:700;font-size:18px;color:var(--parchment)}
.top10-row{padding:9px 6px;gap:14px}
.top10-row:hover{background:var(--card-hover)}
.top10-name{font-size:15px}
.top10-set{font-size:13.5px}
.top10-rank{color:var(--gold-dim)}
.top10-hint{font-size:13.5px}
.reissue-version-img{background:#fff;border:1px solid var(--rule)}
.reissue-version-list{border-radius:8px}
.btn-share{font-family:'Noto Sans KR',sans-serif;font-size:15px;border-radius:8px;border:1.5px solid var(--gold-dim);padding:10px 20px}

/* 상세 모달 */
.modal-backdrop{background:rgba(9,15,30,.62)}
.modal-box{border:0;border-top:5px solid var(--hq-gold);border-radius:12px}
.modal-img{background:#fff;height:220px}
.modal-body h2{font-family:'Gothic A1',sans-serif;font-weight:700;font-size:21px;color:var(--parchment);line-height:1.35}
.modal-meta{font-family:'Noto Sans KR',sans-serif;font-size:14px;color:var(--sage)}
.modal-desc{font-size:15px;line-height:1.75}
.modal-verify-link{font-family:'Noto Sans KR',sans-serif;font-size:14px}

footer{font-size:14px;color:var(--sage-dim)}
:root[data-theme="dark"] .card-img,:root[data-theme="dark"] .set-boxart,:root[data-theme="dark"] .modal-img,:root[data-theme="dark"] .reissue-version-img{background:#e9edf4}

@media(max-width:768px){.wrap{padding:0 14px 60px}.controls input[type=text]{flex:1 1 100%}.controls select{flex:1 1 40%}header{padding:48px 16px 36px}.theme-header{font-size:17px;padding:12px 14px}.card-name{font-size:14.5px}.card-img{height:150px}}
@media(prefers-reduced-motion:reduce){.card,.card:hover{transition:none;transform:none}}

/* 구하기 등급 + 상세 설명 (2026-09-21) */
.tag-row{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:6px;align-items:center}
.tag-row .tier-tag{margin-bottom:0}
.ob-tag{display:inline-block;font-family:'Noto Sans KR',sans-serif;font-size:12px;font-weight:500;line-height:1.5;padding:1px 9px;border-radius:999px;border:1.5px solid currentColor;background:transparent;white-space:nowrap}
.ob-tag.o1{color:#1f6b47}.ob-tag.o2{color:#2c5596}.ob-tag.o3{color:#8a5200}.ob-tag.o4{color:#7a1f5c}
:root[data-theme="dark"] .ob-tag.o1{color:#6fd3a0}:root[data-theme="dark"] .ob-tag.o2{color:#8fb6f2}:root[data-theme="dark"] .ob-tag.o3{color:#e8b04a}:root[data-theme="dark"] .ob-tag.o4{color:#e79ac9}
.obtain-legend{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:-16px 0 28px}
.obtain-note{font-size:13px;color:var(--sage-dim);flex-basis:100%;line-height:1.6}
.modal-desc{font-size:14.5px;line-height:1.75}
.desc-sec{margin:0 0 14px}
.desc-sec:last-child{margin-bottom:0}
.desc-h{font-size:13px;font-weight:600;color:var(--gold-dim);margin-bottom:2px}
.desc-en{margin-top:4px;font-size:13.5px;color:var(--sage);word-break:normal;overflow-wrap:anywhere}
.modal-body .tag-row{margin-bottom:4px}
.tier-tag.t-common{color:var(--t-common);background:#8a94821f}.tier-tag.t-rare{color:var(--t-rare);background:#5f9bd11f}.tier-tag.t-epic{color:var(--t-epic);background:#a06fd81f}.tier-tag.t-legend{color:var(--t-legend);background:#c2790a29}
.update-badge{display:inline-block;margin-top:16px;padding:5px 16px;border:1.5px solid rgba(232,184,58,.75);border-radius:999px;color:var(--hq-gold);font-size:13.5px;font-weight:500;letter-spacing:.01em}
.tabbar{display:flex;gap:6px;margin-bottom:18px;border-bottom:2px solid var(--rule)}
.tabbar button{font-family:'Noto Sans KR',sans-serif;font-size:16px;font-weight:600;padding:12px 20px;background:transparent;border:0;border-bottom:3px solid transparent;margin-bottom:-2px;color:var(--sage-dim);cursor:pointer;border-radius:8px 8px 0 0}
.tabbar button:hover{color:var(--parchment);background:var(--card-hover)}
.tabbar button.active{color:var(--gold);border-bottom-color:var(--hq-gold)}
.tab-n{font-size:12.5px;font-weight:500;color:var(--sage-dim);margin-left:4px}
@media(max-width:768px){.tabbar button{font-size:14.5px;padding:10px 12px;flex:1}}

/* ===== v4: 어벤져스 본부 HUD 스타일 (2026-09-22) ===== */
:root{--hq:#0a1226;--hq-2:#13213f;--steel:#dfe5ef;--reactor:#5cc8ff;--reactor-dim:rgba(92,200,255,.35);--iron:#c8932a;--gold:#1d3a6e;--panel:#101b35;--panel-2:#172649;--panel-ink:#eef3fb}
:root[data-theme="dark"]{--bg:#070c19;--bg-2:#0c1426;--card:#0f1930;--card-hover:#15223f;--rule:#23345a;--hq:#050914;--hq-2:#0d1830;--gold:#f0c35a;--panel:#0c1630;--panel-2:#132448}
body{background:
  linear-gradient(180deg,rgba(255,255,255,0) 0,rgba(255,255,255,0) 100%),
  var(--bg)}

/* 헤더: 아크 리액터 HUD */
header{padding:74px 20px 64px;margin-bottom:0;overflow:visible}
header:before{background:
  radial-gradient(ellipse 60% 90% at 50% 0%,rgba(92,200,255,.16),transparent 70%),
  repeating-linear-gradient(60deg,rgba(92,200,255,.05) 0 1px,transparent 1px 22px),
  repeating-linear-gradient(-60deg,rgba(92,200,255,.05) 0 1px,transparent 1px 22px),
  linear-gradient(180deg,var(--hq-2),var(--hq))}
.hud{position:absolute;z-index:-1;left:50%;top:50%;width:min(560px,120vw);aspect-ratio:1;transform:translate(-50%,-50%);pointer-events:none;border-radius:50%;
  background:
   radial-gradient(circle,rgba(92,200,255,.22) 0 9%,transparent 22%),
   repeating-conic-gradient(from 0deg,rgba(92,200,255,.55) 0 .6deg,transparent .6deg 6deg);
  -webkit-mask:radial-gradient(circle,#000 0 8%,transparent 8.5% 40%,#000 40.5% 42%,transparent 42.5% 47%,#000 47.5% 49.5%,transparent 50%);
          mask:radial-gradient(circle,#000 0 8%,transparent 8.5% 40%,#000 40.5% 42%,transparent 42.5% 47%,#000 47.5% 49.5%,transparent 50%);
  opacity:.55;animation:hudspin 90s linear infinite}
.hud:after{content:"";position:absolute;inset:14%;border-radius:50%;border:1px solid rgba(232,184,58,.35);border-left-color:transparent;border-right-color:transparent}
@keyframes hudspin{to{transform:translate(-50%,-50%) rotate(360deg)}}
header:after{height:5px;background:linear-gradient(90deg,#b8322f 0 16%,#e0a93a 16% 30%,#2f63b8 30% 46%,#9aa8bf 46% 60%,#3f8f4e 60% 74%,#1b1f2a 74% 86%,#6b4bb0 86%)}
header h1{font-size:clamp(34px,5.6vw,58px);font-weight:700;letter-spacing:.01em;color:#eef2f8;background:linear-gradient(180deg,#ffffff 0,#e7ecf4 48%,#a7b3c8 52%,#dfe5ef 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;text-shadow:none;filter:drop-shadow(0 2px 0 rgba(0,0,0,.55)) drop-shadow(0 0 18px rgba(92,200,255,.35))}
.eyebrow{display:inline-block;background:transparent;color:var(--reactor);border:1px solid var(--reactor-dim);font-weight:600;font-size:13.5px;letter-spacing:.12em;padding:5px 16px;border-radius:2px;transform:none;box-shadow:0 0 14px rgba(92,200,255,.18) inset;margin-bottom:18px;clip-path:polygon(8px 0,100% 0,100% calc(100% - 8px),calc(100% - 8px) 100%,0 100%,0 8px)}
.sub{font-size:17px;color:#c9d3e6}
.update-badge{border-color:rgba(232,184,58,.6);color:#f0c35a;background:rgba(232,184,58,.06);border-radius:2px}

/* 본문 시작: 헤더 아래 스틸 패널 */
.wrap > .tabbar{margin-top:32px}

/* 탭: HUD 세그먼트 */
.tabbar{border:0;gap:0;margin-bottom:22px;background:var(--panel);padding:5px;border-radius:10px;display:inline-flex;box-shadow:0 8px 24px rgba(10,18,38,.18)}
.tabbar button{border:0;border-radius:7px;background:transparent;color:#aeb9cf;padding:11px 22px;margin:0;box-shadow:none;transition:background .15s,color .15s}
.tabbar button:hover{color:#fff;background:rgba(255,255,255,.06);transform:none;box-shadow:none}
.tabbar button.active{background:linear-gradient(180deg,#1f3666,#162a52);color:#fff;box-shadow:inset 0 0 0 1px var(--reactor-dim),0 0 16px rgba(92,200,255,.25)}
.tabbar button.active .tab-n{color:var(--reactor)}
.tab-n{color:#8190ad}

/* 컨트롤 */
.controls input[type=text],.controls select,.advanced-row select,.shipping-control input,.reset-filters-btn{border:1.5px solid var(--rule);box-shadow:none;border-radius:8px}
.controls input[type=text]:focus,.controls select:focus{border-color:var(--reactor);box-shadow:0 0 0 3px rgba(92,200,255,.25)}
.advanced-options{border:1.5px solid var(--rule);box-shadow:none}
.theme-toggle-all button{border:1.5px solid var(--rule);box-shadow:none;color:var(--parchment);font-weight:500}

/* 서브테마 제목: 작전 브리핑 패널 */
.theme-header{position:relative;background:linear-gradient(100deg,var(--panel-2),var(--panel) 60%);color:var(--panel-ink);border:0;border-radius:0;box-shadow:0 6px 18px rgba(10,18,38,.16);font-size:20px;padding:16px 22px 16px 26px;clip-path:polygon(0 0,calc(100% - 18px) 0,100% 18px,100% 100%,18px 100%,0 calc(100% - 18px))}
.theme-header:before{content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:linear-gradient(180deg,var(--reactor),#2f63b8)}
.theme-accordion summary.theme-header:hover{background:linear-gradient(100deg,#1d3160,#12203f 60%);filter:none;transform:none;box-shadow:0 6px 18px rgba(10,18,38,.16),inset 0 0 0 1px var(--reactor-dim)}
.theme-accordion[open] summary.theme-header{background:linear-gradient(100deg,#1d3160,#12203f 60%);border-radius:0;margin-bottom:8px}
.theme-count{color:var(--reactor);opacity:1;font-weight:500}
.theme-accordion summary.theme-header:after{color:var(--reactor)}
.theme-accordion{margin-bottom:14px}

/* 세트 */
.set-head{border-bottom:1px solid var(--rule)}
.set-name{font-size:19px}
.set-boxart{border:1px solid var(--rule);width:72px;height:72px}

/* 카드: 장비 카드 — 모서리 절단 + 등급 발광 */
.card{border:1px solid var(--rule);border-radius:4px;box-shadow:0 2px 6px rgba(10,18,38,.08);clip-path:polygon(0 0,calc(100% - 14px) 0,100% 14px,100% 100%,0 100%);transition:transform .15s,box-shadow .15s}
.card:before{display:block;content:"";position:absolute;left:0;right:0;top:0;height:3px;width:auto;background:var(--tier-line,#9aa8bf);z-index:2}
.card:hover{transform:translateY(-3px);box-shadow:0 12px 26px rgba(10,18,38,.18);border-color:var(--reactor)}
.card-img{background:radial-gradient(circle at 50% 45%,#ffffff 0 36%,#e6ebf3 100%);border-bottom:1px solid var(--rule);height:176px}
:root[data-theme="dark"] .card-img{background:radial-gradient(circle at 50% 45%,#f4f7fc 0 36%,#c6cfdf 100%)}
.card-name{font-size:16px;font-weight:500;line-height:1.45}
.card.t-common{--tier-line:#9aa8bf}
.card.t-rare{--tier-line:#2f7fd8;box-shadow:0 2px 6px rgba(10,18,38,.08)}
.card.t-rare:hover{box-shadow:0 12px 26px rgba(47,127,216,.28)}
.card.t-epic{--tier-line:#7b4fd6;box-shadow:0 2px 6px rgba(10,18,38,.08)}
.card.t-epic:hover{box-shadow:0 12px 26px rgba(123,79,214,.3)}
/* 전설: 아이언맨 금속 + 리액터 발광 */
.card.t-legend{--tier-line:linear-gradient(90deg,#9b1f22,#e0a93a 40%,#fff0c2 55%,#e0a93a 70%,#9b1f22);border:1px solid #d9a441;border-width:1px;background:var(--card);box-shadow:0 0 0 1px rgba(224,169,58,.35),0 4px 14px rgba(200,147,42,.25)}
.card.t-legend:before{height:4px}
.card.t-legend:hover{box-shadow:0 0 0 1px #e0a93a,0 14px 30px rgba(200,147,42,.4);border-color:#e0a93a}
.card.t-legend .card-img{border-bottom-color:#e6c27a;background:radial-gradient(circle at 50% 45%,#fffdf5 0 34%,#f3dfa6 100%)}
.card.t-legend .tier-tag{background:linear-gradient(90deg,#9b1f22,#c8932a);color:#fff}
.wish-btn{border:1px solid rgba(255,255,255,.6)}

/* 통계·순위 */
.stats{border:1px solid var(--rule);box-shadow:none;border-radius:8px}
.stat .num{font-size:28px;font-weight:700}
.top10-section{border:1px solid var(--rule);border-top:4px solid var(--reactor);box-shadow:0 6px 18px rgba(10,18,38,.08);border-radius:8px}
.top10-rank{display:inline-grid;place-items:center;min-width:28px;height:28px;border-radius:50%;background:var(--panel);color:var(--reactor);font-weight:700;font-size:13px;box-shadow:inset 0 0 0 1px var(--reactor-dim)}
.top10-row:nth-child(-n+3) .top10-rank{background:linear-gradient(135deg,#9b1f22,#c8932a);color:#fff;box-shadow:none}
.top10-price{font-weight:600}

/* 상세 모달: 파일 뷰어 */
.modal-backdrop{background:rgba(5,9,20,.72);backdrop-filter:blur(3px)}
.modal-box{border:1px solid var(--reactor-dim);border-top:4px solid var(--reactor);border-radius:6px;box-shadow:0 0 0 1px rgba(92,200,255,.12),0 24px 60px rgba(0,0,0,.45)}
.modal-img{background:radial-gradient(circle at 50% 45%,#fff 0 38%,#e6ebf3 100%);border-bottom:1px solid var(--rule)}
.modal-body h2{font-size:23px}
.modal-prices{gap:12px}
.price-col{background:var(--bg);border:1px solid var(--rule);border-radius:6px;padding:10px 16px;flex:1}
.price-col.new{background:var(--panel);border-color:var(--panel)}
.price-col.new .lbl{color:#9fb0cf}
.price-col.new .val{color:#fff}
.price-col .val{font-size:22px;font-weight:700;color:var(--parchment)}
.price-col .lbl{font-size:13px;color:var(--sage)}
.desc-sec{background:var(--bg);border-left:3px solid var(--reactor);border-radius:0 6px 6px 0;padding:10px 14px;margin-bottom:10px}
.desc-h{color:var(--gold);font-size:13.5px}

@media(max-width:768px){
 header{padding:56px 16px 46px}
 header h1{font-size:27px}
 .hud{width:130vw}
 .tabbar{display:flex}
 .tabbar button{flex:1;white-space:nowrap;font-size:14px;padding:10px 8px}
 .theme-header{font-size:17.5px;padding:13px 16px 13px 20px}
 .card-name{font-size:15px}.card-img{height:150px}
}
@media(max-width:360px){header h1{font-size:23px}}
@media(prefers-reduced-motion:reduce){.hud{animation:none}.card,.tabbar button{transition:none}.card:hover{transform:none}}
header{overflow-x:visible;overflow-y:clip}
.hud{width:min(620px,130vw);opacity:.9;background:repeating-conic-gradient(from 0deg,rgba(92,200,255,.5) 0 .5deg,transparent .5deg 5deg);
  -webkit-mask:radial-gradient(circle,transparent 0 37%,#000 37.3% 38.3%,transparent 38.6% 44%,#000 44.3% 47%,transparent 47.3%);
          mask:radial-gradient(circle,transparent 0 37%,#000 37.3% 38.3%,transparent 38.6% 44%,#000 44.3% 47%,transparent 47.3%)}
.hud:after{inset:18%;border:1.5px solid rgba(232,184,58,.45);border-left-color:transparent;border-right-color:transparent}

/* v4.1 가독성 보강 (2026-09-24) */
/* 제목: 금속 그라데이션 글자 → 밝은 단색 + 은은한 빛 (휴대폰에서 어둡게 보이던 문제) */
header h1{background:none;-webkit-background-clip:border-box;background-clip:border-box;-webkit-text-fill-color:#f7f9fc;color:#f7f9fc;filter:none;text-shadow:0 2px 0 rgba(0,0,0,.45),0 0 22px rgba(92,200,255,.45)}
.sub{color:#dde4f1}
.eyebrow{color:#8fdcff;border-color:rgba(143,220,255,.55)}
/* 본문 글자 대비와 크기 */
body{font-size:16.5px}
.card-name{font-size:16.5px;line-height:1.5;color:var(--parchment)}
.tier-tag,.ob-tag{font-size:13px}
.obtain-note{font-size:14px;line-height:1.7;color:var(--sage)}
.tier-legend{font-size:15px}
.set-name{font-size:20px;line-height:1.35}
.set-year{font-size:15px}
.theme-count{font-size:15px}
.modal-desc{font-size:15.5px;line-height:1.8}
.desc-h{font-size:14px}
.top10-name{font-size:15.5px}.top10-set{font-size:14px}
:root[data-theme="dark"]{--parchment:#f2f5fb;--sage:#c9d2e4;--sage-dim:#aab5cc}
@media(max-width:768px){
 header h1{font-size:28px;text-shadow:0 1px 0 rgba(0,0,0,.5),0 0 16px rgba(92,200,255,.5)}
 .sub{font-size:16px;color:#e6ecf6}
 .hud{opacity:.55}
 body{font-size:16px}
 .card-name{font-size:15.5px}
 .set-name{font-size:18px}
 .theme-header{font-size:18px}
}
@media(max-width:360px){header h1{font-size:24px}}
@media(max-width:768px){header h1{font-size:clamp(21px,6.6vw,27px);letter-spacing:-.01em;white-space:nowrap}}

/* 하단: 방문자 수 + 만든이만 */
footer{padding:28px 16px 40px;text-align:center}
.view-counter{display:inline-flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:6px 10px;padding:9px 18px;border-radius:999px;background:var(--card);border:1px solid var(--rule);font-size:15px;color:var(--sage)}
.view-counter b{color:var(--parchment);font-weight:600}
.vc-sep{color:var(--sage-dim)}
.view-counter,.view-counter *{font-family:'Noto Sans KR',sans-serif;letter-spacing:0}
.copyright-note{margin:10px auto 0;max-width:640px;font-size:12.5px;line-height:1.7;color:var(--sage-dim)}

/* ===== v5 가독성 개선 (2026-09-25) ===== */
/* 1) 세트 블록 모아 배치: 피규어 1~2개짜리 세트가 한 줄을 통째로 차지하던 문제 → 옆으로 나란히 */
@media (min-width:769px){
 .theme-accordion-body{display:flex;flex-wrap:wrap;align-items:flex-start;gap:6px 26px}
 .theme-accordion-body > .set-block{flex:0 1 auto;max-width:100%;min-width:0;margin-bottom:26px}
 .theme-accordion-body > .set-block > .grid{display:flex;flex-wrap:wrap;gap:16px}
 .theme-accordion-body > .set-block > .grid > .card{flex:0 0 var(--cw,170px);width:var(--cw,170px)}
 .theme-accordion-body > .set-block .set-name{white-space:normal}
 .theme-accordion-body > .set-block .set-titles{max-width:560px}
}
@media (min-width:769px) and (max-width:1099px){:root{--cw:156px}}
@media (min-width:1100px){:root{--cw:172px}}
/* 2) 큰 모니터(1700px 이상): 폭을 넓히고 글자·카드를 한 단계 키움 */
@media (min-width:1700px){
 .wrap{max-width:1600px}
 :root{--cw:200px}
 body{font-size:18px}
 .card-img{height:200px}
 .card-name{font-size:17.5px}
 .set-name{font-size:21px}
 .theme-header{font-size:22px}
 .controls input[type=text],.controls select,.reset-filters-btn{font-size:17px;min-height:50px}
 .tabbar button{font-size:17px}
}
@media (min-width:2200px){.wrap{max-width:1900px} :root{--cw:220px} .card-img{height:220px} body{font-size:19px}}
/* 3) 카드 안 정보 정리: 이름이 두 줄 넘어가도 잘리지 않고, 태그는 한 줄에 */
.card-name{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;min-height:0}
.tag-row{gap:4px}
.tier-tag,.ob-tag{white-space:nowrap}
/* 4) 세트 머리글: 번호·이름·연도 간격 정리 */
.set-head{gap:12px;align-items:center}
.set-titles{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 10px}
.set-year{font-variant-numeric:tabular-nums}
/* 5) 구하기 난이도 안내문: 줄 길이 제한으로 읽기 편하게 */
.obtain-note{max-width:760px}
/* 6) 스크롤 중 아코디언 제목이 헤더에 가리지 않게 */
.theme-accordion{scroll-margin-top:12px}
/* 7) 휴대폰: 연도가 혼자 한 줄을 차지하던 것 → 제목 옆에 작게, 태그는 한 줄에 들어가게 */
@media (max-width:768px){
 .set-year{margin-left:0;font-size:13.5px}
 .set-titles{gap:2px 8px}
 .tag-row .tier-tag,.tag-row .ob-tag{font-size:11.5px;padding:1px 7px}
 .set-block{margin-bottom:30px}
}

html:not(.dx-ok) body{visibility:hidden}
